upsert({ "ReplicatedStorage", "Client" }, "Mover", "ModuleScript", [======[
--[[
	Mover
	A cheaper Model:PivotTo for models that move every frame as one rigid piece (a
	brainrot riding a belt, the conveyor's packages, the toy train's cars). PivotTo walks
	the model's descendants and fires every moved part's Position/Orientation/CFrame
	change events each call; this keeps each model's parts and their offsets from its
	pivot, and moves them all with one workspace:BulkMoveTo that only fires CFrame
	changes.

	The cache is only right while the parts hold still relative to each other, so it is
	rebuilt whenever the model's scale changes (a squish is ScaleTo) or a part is added
	or removed (a sticker stuck on); anything else that moves a part inside the model
	on its own must call Mover.Forget(model) first, or use PivotTo. Client only.
]]

type Cache = {
	Parts: { BasePart },
	Offsets: { CFrame },
	Scale: number,
	Dirty: boolean,
	Connections: { RBXScriptConnection },
}

local caches: { [Model]: Cache } = setmetatable({}, { __mode = "k" }) :: any
local targets: { CFrame } = {}

local Mover = {}

local function forget(model: Model)
	local cache = caches[model]
	if cache then
		for _, connection in cache.Connections do
			connection:Disconnect()
		end
		caches[model] = nil
	end
end

local function build(model: Model): Cache
	forget(model)
	local pivot = model:GetPivot()
	local cache: Cache = { Parts = {}, Offsets = {}, Scale = model:GetScale(), Dirty = false, Connections = {} }
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(cache.Parts, descendant)
			table.insert(cache.Offsets, pivot:ToObjectSpace(descendant.CFrame))
		end
	end
	local function dirty(instance: Instance)
		if instance:IsA("BasePart") then
			cache.Dirty = true
		end
	end
	table.insert(cache.Connections, model.DescendantAdded:Connect(dirty))
	table.insert(cache.Connections, model.DescendantRemoving:Connect(dirty))
	table.insert(cache.Connections, model.Destroying:Connect(function()
		forget(model)
	end))
	caches[model] = cache
	return cache
end

-- Puts `model`'s pivot at `cframe`, like model:PivotTo(cframe).
function Mover.PivotTo(model: Model, cframe: CFrame)
	if not model:IsDescendantOf(workspace) then
		model:PivotTo(cframe) -- (BulkMoveTo only moves parts in the world)
		return
	end
	local cache = caches[model]
	if not cache or cache.Dirty or cache.Scale ~= model:GetScale() then
		cache = build(model)
	end
	local count = #cache.Parts
	for index = 1, count do
		targets[index] = cframe * cache.Offsets[index]
	end
	for index = count + 1, #targets do
		targets[index] = nil
	end
	workspace:BulkMoveTo(cache.Parts, targets, Enum.BulkMoveMode.FireCFrameChanged)
	model.WorldPivot = cframe
end

-- Drops what's cached for `model` (call it after moving a part inside it on your own).
function Mover.Forget(model: Model)
	forget(model)
end

return Mover
]======])
upsert({ "ReplicatedStorage", "Client", "UI" }, "Passes", "ModuleScript", [======[
--[[
	Passes
	What the shop and the corner ads (Upsell) share about gamepasses: prices, whether the
	player owns one, whether a limited offer (a pass with OfferHours, e.g. the Starter Pack) is
	still on and for how long, and the purchase prompt. Ownership comes from the server's
	"Pass_<Key>" attributes; the offer's end from "StarterOfferEnds".
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Gamepasses = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Gamepasses"))

local player = Players.LocalPlayer
local prices: { [string]: number | false } = {}

local Passes = {}

-- Robux price of a pass ("Pass") or a developer product ("Product"), fetched once (it
-- yields the first time). Nil if unknown or not on the dashboard yet.
function Passes.PriceOf(kind: string, id: number): number?
	if id <= 0 then
		return nil
	end
	local key = kind .. id
	if prices[key] == nil then
		local infoType = if kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, infoType)
		prices[key] = if ok and info and info.PriceInRobux then info.PriceInRobux else false
	end
	return prices[key] or nil
end

function Passes.Owns(key: string): boolean
	return player:GetAttribute(`Pass_{key}`) == true
end

-- Seconds left on a limited pass's offer (0 once it's over), or nil for a pass that's
-- always on sale.
function Passes.OfferLeft(key: string): number?
	local pass = Gamepasses[key]
	if not (pass and pass.OfferHours) then
		return nil
	end
	local ends = player:GetAttribute("StarterOfferEnds")
	if typeof(ends) ~= "number" then
		return 0 -- not loaded yet: don't show it
	end
	return math.max(0, ends - workspace:GetServerTimeNow())
end

-- Whether the pass can be offered to this player right now: not owned, and its offer
-- (if it has one) still on.
function Passes.OnSale(key: string): boolean
	local left = Passes.OfferLeft(key)
	return Gamepasses[key] ~= nil and not Passes.Owns(key) and (left == nil or left > 0)
end

-- "23:59:07"
function Passes.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d:%02d", seconds // 3600, seconds % 3600 // 60, seconds % 60)
end

-- Prompts the purchase. False if the pass isn't on the dashboard yet (Id 0).
function Passes.Prompt(key: string): boolean
	local pass = Gamepasses[key]
	if not pass or pass.Id <= 0 or Passes.Owns(key) then
		return false
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	return true
end

return Passes
]======])
upsert({ "ReplicatedStorage", "Client", "UI" }, "Upsell", "ModuleScript", [======[
--[[
	Upsell
	A small ad in the top-right corner that offers a gamepass at the moment it would help
	(the user, 2026-10-03): Sprint when you press Shift without it, Lucky / Fast Open
	when loot opens, 2x Coins / Auto-Collect / VIP when you collect the Cash Pad, the
	Starter Pack (with its countdown) after joining. It slides in beside the music and
	settings buttons, says what the pass does, and BUY prompts the purchase; it slides
	away by itself.

